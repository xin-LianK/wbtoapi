# Auth & secrets
auths/
data/
*.key
*.pem
*.env
.env
.env.*

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/signin_bin

# Config with secrets (use config.example.json)
config.json

# Build artifacts
*.tmp
__pycache__/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
docs/

# 设计/计划文档（但 README.md 必须进版本库）
*.md
!README.md
# 维护手册必须进版本库（上游停更后这是最重要的文档）
!MAINTENANCE.md

# 本地部署产物（deploy.sh 的编译输出，体积约 30MB，不进库）
/dist/

# Windows binaries
/wb2api.exe
/login.exe
/credit.exe

# 本地验证工具（判据逆向过程脚本，结论沉淀于 data/desktop-task-protocol.md）
/cmd/desktopverify*/
*.zip
server.exe
.DS_Store

# python 字节码
__pycache__/
*.pyc

# Capture output (TLS MITM dumps)
/capture/

# vendored undici: NODE_OPTIONS shim payload, not part of the Go build
/tools/vendor/

# Electron crashpad noise: the capture launcher starts the app with cwd=tools/
/tools/debug.log
